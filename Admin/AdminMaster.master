<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminMaster.master.cs" Inherits="CYPHER.Admin.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">CYPHER Admin</asp:ContentPlaceHolder> — CYPHER Luxury Watches</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Admin CSS -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/css/admin.css?v=2.5") %>" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="adminForm" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <div class="admin-wrapper">
            <!-- ── SIDEBAR ── -->
            <aside class="admin-sidebar" id="adminSidebar">
                <div class="sidebar-logo">
                    CY<span style="color:#FFF;">PHER</span>
                    <small>Admin Suite</small>
                </div>

                <nav class="sidebar-nav">
                    <div class="sidebar-section-label">Core</div>
                    <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="sidebar-nav-item <%= IsActive("Dashboard.aspx") %>">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="sidebar-section-label">Catalog</div>
                    <a href="<%= ResolveUrl("~/Admin/Products.aspx") %>" class="sidebar-nav-item <%= IsActive("Products.aspx") %>">
                        <i class="fas fa-clock"></i>
                        <span>Watches / Products</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Categories.aspx") %>" class="sidebar-nav-item <%= IsActive("Categories.aspx") %>">
                        <i class="fas fa-layer-group"></i>
                        <span>Categories</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Brands.aspx") %>" class="sidebar-nav-item <%= IsActive("Brands.aspx") %>">
                        <i class="fas fa-gem"></i>
                        <span>Brands</span>
                    </a>

                    <div class="sidebar-section-label">Operations</div>
                    <a href="<%= ResolveUrl("~/Admin/Orders.aspx") %>" class="sidebar-nav-item <%= IsActive("Orders.aspx") %>">
                        <i class="fas fa-shopping-bag"></i>
                        <span>Orders</span>
                        <% if (PendingOrdersCount > 0) { %>
                            <span class="nav-badge danger"><%= PendingOrdersCount %></span>
                        <% } %>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Users.aspx") %>" class="sidebar-nav-item <%= IsActive("Users.aspx") %>">
                        <i class="fas fa-users"></i>
                        <span>Customers</span>
                    </a>

                    <div class="sidebar-section-label">Marketing & Growth</div>
                    <a href="<%= ResolveUrl("~/Admin/Reviews.aspx") %>" class="sidebar-nav-item <%= IsActive("Reviews.aspx") %>">
                        <i class="fas fa-star"></i>
                        <span>Reviews</span>
                        <% if (PendingReviewsCount > 0) { %>
                            <span class="nav-badge"><%= PendingReviewsCount %></span>
                        <% } %>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Coupons.aspx") %>" class="sidebar-nav-item <%= IsActive("Coupons.aspx") %>">
                        <i class="fas fa-ticket-alt"></i>
                        <span>Coupons</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Reports.aspx") %>" class="sidebar-nav-item <%= IsActive("Reports.aspx") %>">
                        <i class="fas fa-chart-line"></i>
                        <span>Sales Reports</span>
                    </a>
                </nav>

                <div style="padding: 1.25rem; border-top: 1px solid var(--admin-border);">
                    <a href="<%= ResolveUrl("~/Pages/Home.aspx") %>" target="_blank" class="sidebar-nav-item" style="padding: 0.5rem 0; margin-bottom: 0.5rem;">
                        <i class="fas fa-external-link-alt"></i>
                        <span>View Live Store</span>
                    </a>
                    <asp:LinkButton ID="lnkLogout" runat="server" OnClick="lnkLogout_Click" CssClass="sidebar-nav-item" style="padding: 0.5rem 0; color: #e74c3c;">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Sign Out</span>
                    </asp:LinkButton>
                </div>
            </aside>

            <!-- ── MAIN CONTENT ── -->
            <div class="admin-main">
                <!-- Topbar -->
                <header class="admin-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" id="btnToggleSidebar">
                            <i class="fas fa-bars"></i>
                        </button>
                        <div class="topbar-title">
                            <asp:ContentPlaceHolder ID="PageHeaderContent" runat="server">
                                Control Panel
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <a href="<%= ResolveUrl("~/Pages/Home.aspx") %>" target="_blank" class="btn-admin-outline d-none d-sm-inline-flex">
                            <i class="fas fa-external-link-alt"></i> Live Store
                        </a>

                        <div class="d-flex align-items-center gap-2">
                            <div class="admin-avatar">
                                <%= AdminInitial %>
                            </div>
                            <div class="d-none d-md-block" style="line-height: 1.2;">
                                <div style="font-size: 0.85rem; font-weight: 600; color: #F5F5F5;"><%= AdminName %></div>
                                <div style="font-size: 0.7rem; color: #888;">Administrator</div>
                            </div>
                        </div>

                        <asp:LinkButton ID="lnkTopLogout" runat="server" OnClick="lnkLogout_Click" CssClass="btn-admin-icon danger" ToolTip="Logout">
                            <i class="fas fa-sign-out-alt"></i>
                        </asp:LinkButton>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="admin-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar toggle for mobile
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('btnToggleSidebar');
            var sidebar = document.getElementById('adminSidebar');
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('open');
                });
            }

            // Fallback for broken images
            document.querySelectorAll('img').forEach(function (img) {
                img.addEventListener('error', function () {
                    if (!this.getAttribute('data-tried-fallback')) {
                        this.setAttribute('data-tried-fallback', 'true');
                        this.src = '<%= ResolveUrl("~/Content/images/watches/watch_hero.jpg") %>';
                    }
                });
            });
        });
    </script>
</body>
</html>
